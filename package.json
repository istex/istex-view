{
	"name": "@istex/viewer-monorepo",
	"license": "CeCILL",
	"version": "1.2.0",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"lint:apply": "biome check --write",
		"lint:check": "biome check --error-on-warnings",
		"test": "vitest run --browser.headless",
		"test:watch": "vitest watch --browser.headless",
		"test:browser": "vitest watch",
		"typecheck": "tsc --noEmit"
	},
	"private": true,
	"dependencies": {
		"@istex/react-tei": "workspace:^",
		"@istex/viewer-demo": "workspace:^"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@types/node": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"husky": "catalog:",
		"playwright": "catalog:",
		"turbo": "^2.11.5",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.9.1"
		}
	}
}
